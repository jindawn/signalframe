            "maxLength": 20000
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HypothesisDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis",
          "timeline",
          "evidence",
          "predictions"
        ],
        "properties": {
          "hypothesis": {
            "$ref": "#/components/schemas/Hypothesis"
          },
          "timeline": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HypothesisEvent"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          },
          "predictions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Prediction"
            }
          }
        }
      },
      "ModelProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "model",
          "baseUrl",
          "apiKeyEnv",
          "temperature",
          "maxTokens",
          "timeout",
          "structuredOutput",
          "toolCalling",
          "enabled"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "baseUrl": {
            "type": "string"
          },
          "apiKeyEnv": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "maxTokens": {
            "type": "integer",
            "minimum": 128,
            "maximum": 32000
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "structuredOutput": {
            "type": "boolean"
          },
          "toolCalling": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "NamedModelProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "profile",
          "effectiveMode"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "profile": {
            "$ref": "#/components/schemas/ModelProfile"
          },
          "effectiveMode": {
            "type": "string",
            "enum": [
              "MOCK",
              "LIVE",
              "DISABLED"
            ]
          }
        }
      },
      "ModelRun": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "jobId",
          "provider",
          "model",
          "purpose",
          "promptVersion",
          "startedAt",
          "completedAt",
          "latencyMs",
          "inputTokens",
          "outputTokens",
          "totalTokens",
          "estimatedCost",
          "status",
          "errorType",
          "correlationId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "purpose": {
            "$ref": "#/components/schemas/ModelPurpose"
          },
          "promptVersion": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "latencyMs": {
            "type": "integer",
            "format": "int64"
          },
          "inputTokens": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "outputTokens": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "totalTokens": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "estimatedCost": {
            "type": [
              "number",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "SUCCEEDED",
              "FAILED"
            ]
          },
          "errorType": {
            "type": [
              "string",
              "null"
            ]
          },
          "correlationId": {
            "type": "string"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        }
      }
    }
  }
}
