DATABASE_URL=jdbc:postgresql://localhost:5432/signalframe
DATABASE_USER=signalframe
POSTGRES_PASSWORD=local-development-only
AI_DEFAULT_PROFILE=analysis.fast

# Offline defaults: no key is required and the pipeline runs on the mock adapter.
AI_FAST_PROVIDER=mock
AI_FAST_MODEL=mock-v1
AI_FAST_BASE_URL=https://api.deepseek.com
AI_FAST_API_KEY=
AI_DEEP_PROVIDER=mock
AI_DEEP_MODEL=mock-v1
AI_DEEP_BASE_URL=https://api.deepseek.com
AI_DEEP_API_KEY=

# Real OpenAI-compatible provider. Replace the placeholders with the values from
# your provider console, keep the key in this ignored file only, and never commit
# or paste a real key anywhere else. See docs/ai-runtime/REAL_MODEL_E2E.md.
# AI_FAST_PROVIDER=openai-compatible
# AI_FAST_MODEL=replace-with-provider-model-id
# AI_FAST_BASE_URL=https://api.deepseek.com/v1
# AI_FAST_API_KEY=
#
# Local OpenAI-compatible server (Ollama, vLLM, LM Studio). Plain HTTP is only
# accepted on a loopback host, and any non-blank placeholder satisfies the
# credential check.
# AI_FAST_PROVIDER=openai-compatible
# AI_FAST_MODEL=<local-model>
# AI_FAST_BASE_URL=http://127.0.0.1:11434/v1
# AI_FAST_API_KEY=ollama
#
# Per-profile generation budget. Defaults are the compatible values; a metered
# rehearsal or a reasoning model overrides them without editing application.yml.
# Raising AI_FAST_MAX_TOKENS widens the completion budget but does NOT extend the
# timeout, so a much larger ceiling can turn a truncation into a timeout.
# AI_FAST_MAX_TOKENS=8192
# AI_FAST_TIMEOUT=45
#
# How many provider requests one analysis may issue. max-attempts counts transport
# attempts per round, max-repair-attempts the extra round a schema/provenance
# failure is allowed. Setting 1 and 0 makes a run single-shot: exactly one
# provider request, which is what a metered endpoint is rehearsed with.
# AI_RETRY_MAX_ATTEMPTS=2
# AI_RETRY_MAX_REPAIR_ATTEMPTS=1
# AI_RETRY_BACKOFF_MS=250
#
# Opt-in real model verification. Unset means the suite is skipped, so a keyless
# machine and CI stay green.
# AI_REAL_MODEL_E2E=true
# AI_REAL_MODEL_E2E_ANALYSIS=true
# AI_REAL_MODEL_E2E_TIMEOUT_SECONDS=120
# AI_REAL_MODEL_E2E_JOB_TIMEOUT_SECONDS=900
#
# Client identity and session correlation (application.yml `ai.client`). The
# User-Agent must name this runtime; it is never a third-party client's name.
# The session header is what a gateway uses to attribute the transport retry and
# the single repair round of one analysis to one session; its value is derived
# from the job id, so it is stable per analysis and opaque. Leave the name blank
# or disable it for a provider that does not want the header.
# AI_CLIENT_USER_AGENT=SignalFrame/0.1.0
# AI_SESSION_HEADER_NAME=x-opencode-session
# AI_SESSION_HEADER_ENABLED=true

API_BASE_URL=http://localhost:8080
